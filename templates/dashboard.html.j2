<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src data:">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ReadyHai dashboard</title>
<style>
:root{--bg:#f7f8fa;--fg:#1c2128;--muted:#5b6572;--card:#fff;--line:#dde2e8;--pass:#1a7f37;--warn:#b7791f;--fail:#c62828;--acc:#2563a8}
@media (prefers-color-scheme:dark){:root{--bg:#0f1318;--fg:#e6e9ee;--muted:#9aa4b2;--card:#171c23;--line:#2a323d;--pass:#3fb950;--warn:#e3b341;--fail:#f47067;--acc:#6cb0f5}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font:14px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
main{max-width:1100px;margin:0 auto;padding:16px}
h1{font-size:1.4rem}h2{font-size:1.1rem;margin:1.6rem 0 .5rem;word-break:break-all}
.card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:12px 14px;margin:12px 0}
.tw{overflow-x:auto}
table{border-collapse:collapse;width:100%}
th,td{padding:5px 9px;border-bottom:1px solid var(--line);text-align:left;font-size:.86rem;vertical-align:top}
th{color:var(--muted)}td.n{text-align:right}
.PASS,.GO{color:var(--pass)}.WARN{color:var(--warn)}.FAIL,.NO-GO{color:var(--fail)}.CONDITIONAL{color:var(--warn)}
.spark{display:inline-block;margin-right:16px;color:var(--muted);font-size:.78rem}
.spark svg{display:block;stroke:var(--acc);fill:none;stroke-width:1.6}
.spark.p svg{stroke:var(--pass)}
.k{color:var(--muted);font-size:.8rem}
footer{color:var(--muted);font-size:.8rem;margin:2rem 0}
</style>
</head>
<body><main>
<h1>ReadyHai dashboard</h1>
<p class="k">{{ count }} run(s) indexed.</p>
{% for t in targets %}
<div class="card">
<h2>{{ t.target }} <span class="k">({{ t.kind }}, {{ t.runs_n }} runs)</span></h2>
<p>Latest: <b class="{{ t.latest.verdict }}">{{ t.latest.verdict }}</b>{% if t.latest.rec %} &middot; recommendation <b>{{ t.latest.rec }}</b>{% endif %} &middot; {{ t.latest.total }} finding(s), {{ t.latest.new }} new{% if t.latest.pass_rate %} &middot; pass rate {{ t.latest.pass_rate }}{% endif %}{% if t.latest.p95 %} &middot; p95 {{ t.latest.p95 }}{% endif %}</p>
<div>
{% if t.spark_findings %}<span class="spark">Findings (last 30)<svg viewBox="0 0 120 28" width="120" height="28" role="img" aria-label="Findings trend"><polyline points="{{ t.spark_findings }}"/></svg></span>{% endif %}
{% if t.spark_pass %}<span class="spark p">Pass rate (last 30)<svg viewBox="0 0 120 28" width="120" height="28" role="img" aria-label="Pass rate trend"><polyline points="{{ t.spark_pass }}"/></svg></span>{% endif %}
</div>
<div class="tw"><table>
<tr><th>Run</th><th>Date</th><th>Verdict</th><th>Recommendation</th><th>Findings</th><th>New</th><th>Pass rate</th><th>Defects</th><th>p95</th></tr>
{% for r in t.runs %}<tr><td>{% if r.link %}<a href="{{ r.link }}">{{ r.id }}</a>{% else %}{{ r.id }}{% endif %}</td><td>{{ r.date }}</td><td class="{{ r.verdict }}">{{ r.verdict }}</td><td>{{ r.rec or "" }}</td><td class="n">{{ r.total }}</td><td class="n">{{ r.new }}</td><td class="n">{{ r.pass_rate or "" }}</td><td class="n">{{ r.defects if r.defects is not none else "" }}</td><td class="n">{{ r.p95 or "" }}</td></tr>
{% endfor %}</table></div>
</div>
{% endfor %}
<h2>All runs</h2>
<div class="card tw"><table>
<tr><th>Date</th><th>Target</th><th>Run</th><th>Verdict</th><th>Recommendation</th><th>Findings</th><th>New</th></tr>
{% for r in overall %}<tr><td>{{ r.date }}</td><td>{{ r.target }}</td><td>{% if r.link %}<a href="{{ r.link }}">{{ r.id }}</a>{% else %}{{ r.id }}{% endif %}</td><td class="{{ r.verdict }}">{{ r.verdict }}</td><td>{{ r.rec or "" }}</td><td class="n">{{ r.total }}</td><td class="n">{{ r.new }}</td></tr>
{% endfor %}</table></div>
<footer>Generated by ReadyHai {{ version }}. Static, offline, no scripts.</footer>
</main></body></html>
