# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Explicitly ensure shell scripts and configs use LF
*.sh text eol=lf
*.bash text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
Makefile text eol=lf

# Windows PowerShell scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
