# ReadyHai local stack (docker compose). Copy to .env and set a real token.

# Bearer token for the ReadyHai API (>=16 chars, no spaces). The UI container
# attaches it server-side, so you never paste it into the browser.
READYHAI_TOKEN=change-me-to-a-long-random-value

# Name recorded on sign-offs (approve/reject) made with this token.
READYHAI_PRINCIPAL=local-admin

# Host ports (bound to 127.0.0.1 only).
READYHAI_PORT=8080
FRONTEND_PORT=3000

# Host directory with repos to scan, mounted read-only at /targets.
TARGETS_DIR=./targets

# Rules of engagement for web/API/agent/network tests.
SCOPE_FILE=./scope.toml

# Optional LLM. Leave READYHAI_LLM_URL empty for deterministic mode.
# Base URL of any OpenAI-compatible server (vLLM, Ollama, LiteLLM ...) or of the provider named by
# READYHAI_LLM_PROVIDER. Replaces the deprecated READYHAI_VLLM_URL.
READYHAI_LLM_URL=
# Key for that endpoint (sent as a bearer token, or x-api-key for anthropic). Optional for local servers.
READYHAI_LLM_API_KEY=
# One model, or a comma-separated list: the first is used, the rest are tried in order if a call fails.
# READYHAI_LLM_MODEL=Qwen/Qwen3-8B,Qwen/Qwen3-4B
READYHAI_LLM_MODEL=Qwen/Qwen3-8B
# A URL on the public internet, or a cloud provider, also needs READYHAI_LLM_ALLOW_CLOUD=1.
# READYHAI_LLM_ALLOW_CLOUD=
