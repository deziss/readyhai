# ReadyHai local stack (docker compose). Copy to .env and set a real token.

# Bearer token for the ReadyHai API (>=16 chars, no spaces). The UI container
# attaches it server-side, so you never paste it into the browser.
READYHAI_TOKEN=change-me-to-a-long-random-value

# Name recorded on sign-offs (approve/reject) made with this token.
READYHAI_PRINCIPAL=local-admin

# Host ports (bound to 127.0.0.1 only).
READYHAI_PORT=8080
FRONTEND_PORT=3000

# Host directory with repos to scan, mounted read-only at /targets.
TARGETS_DIR=./targets

# Rules of engagement for web/API/agent/network tests.
SCOPE_FILE=./scope.toml

# Optional LAN LLM (OpenAI-compatible vLLM). Leave empty for deterministic mode.
READYHAI_VLLM_URL=
READYHAI_LLM_MODEL=Qwen/Qwen3-8B
